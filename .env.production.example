# ==============================================================================
# AI BANK STATEMENT PARSER MICRO-SAAS -- PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Application Settings
PROJECT_NAME="AI Bank Statement Parser"
API_V1_STR="/api"
SECRET_KEY="replace-this-with-a-random-secure-64-character-jwt-signing-secret"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Supabase PostgreSQL, Render PostgreSQL, or Neon)
# Example Supabase pooled connection string:
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# File Upload Storage Directory
UPLOAD_DIR="storage/uploads"

# Stripe Production Billing Configuration
# Set to 'live' for real payments, or 'mock' for zero-config testing mode
BILLING_MODE="live"
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_PUBLISHABLE_KEY="pk_live_..."
# Webhook secret generated when pointing Stripe to https://your-domain.com/api/billing/webhook
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Pricing Tier Page Limits
FREE_PAGE_LIMIT=5
STARTER_PAGE_LIMIT=50
PRO_PAGE_LIMIT=500

# Optional: Google Gemini API Key for Vision Extraction fallback
GEMINI_API_KEY=""
